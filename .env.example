# 环境变量示例，复制为 .env 并按需修改
DJANGO_ENV=dev
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# 生产环境 TLS / CSRF（默认关闭，适配当前 nginx 纯 HTTP 反代）
# 部署 HTTPS 后设 DJANGO_USE_TLS=true，并按需设置 HSTS 秒数与信任来源
# DJANGO_USE_TLS=true
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_CSRF_TRUSTED_ORIGINS=https://blog.example.com

# 预留：如未来启用 PostgreSQL/Redis，需同时恢复 docker-compose 中的 db/redis 服务
# Redis 用于缓存与登录失败限流（跨进程共享；未设置时使用进程内缓存）
# REDIS_URL=redis://redis:6379/0
# POSTGRES_DB=my_blog
# POSTGRES_USER=my_blog
# POSTGRES_PASSWORD=change-me
# POSTGRES_HOST=db
# POSTGRES_PORT=5432
