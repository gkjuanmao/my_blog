# 环境变量示例，复制为 .env 并按需修改
DJANGO_ENV=dev
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# 生产环境 TLS / CSRF（默认关闭，适配当前 nginx 纯 HTTP 反代）
# 部署 HTTPS 后设 DJANGO_USE_TLS=true，并按需设置 HSTS 秒数与信任来源
# DJANGO_USE_TLS=true
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_CSRF_TRUSTED_ORIGINS=https://blog.example.com

# 预留：PostgreSQL 尚未启用（compose 已含 redis 服务）
# ⚠️ REDIS_URL 默认已启用：不配则 prod 回落「每进程」LocMemCache，
#    多 worker 下导入锁 / 登录失败限流会各自为政（prod 会打 RuntimeWarning）。
#    compose 的 app 服务已自动注入同一值；下面的行主要给**手工跑 prod** 用
#    （手工时需自行 `export REDIS_URL=...`，Django 不会自动读 .env）。
REDIS_URL=redis://redis:6379/0
# POSTGRES_DB=my_blog
# POSTGRES_USER=my_blog
# POSTGRES_PASSWORD=change-me
# POSTGRES_HOST=db
# POSTGRES_PORT=5432

# API 文档（Swagger UI，/api/v1/docs）：生产默认关闭（仅开发环境自动开启），需要时显式开放
# ENABLE_API_DOCS=true
