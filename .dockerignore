# 虚拟环境与缓存（uv sync 会在镜像内重建，无需打包本地 venv）
.venv/
venv/
__pycache__/
*.py[cod]
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# 本地数据与敏感文件（运行时通过 volume / env_file 提供）
.env
.env.example
db.sqlite3
db_data/
media/
staticfiles/

# 源码管理
.git/
.gitignore
.dockerignore
docker-compose.yml

# 测试（运行时不需要）
tests/

# 本地工具 / 编辑器
.omo/
.obsidian/
.idea/
.vscode/
.python-version
*.log

# 前端构建产物（front/ 下另有独立 .dockerignore）
front/node_modules/
front/.nuxt/
front/.output/
front/.data/
